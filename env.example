# === Supabase ===
# Los encontrás en tu proyecto de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# === Transcripción por IA (Anthropic Claude con visión) ===
# Se usa solo del lado del servidor. Obtené la clave en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelo con visión (podés cambiarlo). Ej: claude-3-5-sonnet-latest
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
